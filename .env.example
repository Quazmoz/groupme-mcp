# ==============================================================================
# GROUPME MCP SERVER CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED: GroupMe API Credentials
# ------------------------------------------------------------------------------
# Get your access token from https://dev.groupme.com/
GROUPME_ACCESS_TOKEN=your-access-token-here

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
# Port for the MCP server to listen on
PORT=5000

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Transport Mode
# Set to "stdio" for Claude Desktop/Cursor, or "http" (legacy: "sse") for network setups
MCP_TRANSPORT=http

# ------------------------------------------------------------------------------
# Optional: Multi-User / Stateful Mode
# ------------------------------------------------------------------------------
TOOL_PROFILE=default
ENCRYPTION_KEY=
JWT_SECRET=
MCP_SERVER_URI=
TOKEN_EXPIRY_DAYS=30
DEFAULT_USER=

# Database / Redis
DATABASE_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=

# ------------------------------------------------------------------------------
# Security / Auth Hardening
# ------------------------------------------------------------------------------
# CORS settings (e.g. "http://localhost:3000,https://my-app.com")
# Empty or not set defaults to strict/no cross-origin.
CORS_ALLOWED_ORIGINS=

# Trusted Proxy Headers (X-Authenticated-User, X-User-Email)
TRUSTED_PROXY_HEADERS_ENABLED=false

# Direct Token Header (X-GroupMe-Access-Token)
DIRECT_TOKEN_HEADER_ENABLED=false

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_RPM=120
RATE_LIMIT_USER_RPM=30
RATE_LIMIT_AUTH_RPM=10
RATE_LIMIT_BURST=10

# ------------------------------------------------------------------------------
# Abuse Controls & Guardrails
# ------------------------------------------------------------------------------
HIGH_IMPACT_TOOLS_ENABLED=true
BROADCAST_TOOLS_ENABLED=false
MAX_SENDS_PER_TOOL_CALL=3
MAX_MESSAGE_CHARS=1000
MAX_DM_SENDS_PER_MINUTE=10
MAX_GROUP_SENDS_PER_MINUTE=20
MAX_ALL_MENTION_GROUP_SIZE=25
REQUIRE_CONFIRMATION_FOR_BROADCAST=true
DRY_RUN_HIGH_IMPACT_TOOLS=false

# ------------------------------------------------------------------------------
# Loop / Duplicate Prevention
# ------------------------------------------------------------------------------
DEDUPE_SENDS_ENABLED=true
DEDUPE_WINDOW_SECONDS=60
